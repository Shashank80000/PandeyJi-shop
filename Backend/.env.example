# ===== Backend (.env) — server-side only, NEVER exposed to the browser =====
PORT=5001

# MongoDB connection string (Atlas or local). Required.
MONGO_URI=

# JWT secrets — use long random strings. Required.
JWT_SECRET=
JWT_ADMIN_SECRET=

# Admin bootstrap credentials (used ONLY while no admin account exists).
# Remove/rotate DEFAULT_ADMIN_PASSWORD after first login.
ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Cloudinary credentials. Required for product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins (CORS allowlist).
# Example: https://pandeyji-shop.vercel.app,https://your-custom-domain.com
CLIENT_ORIGIN=
